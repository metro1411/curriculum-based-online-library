/data/
/uploads/
/instance/

# Environment secrets (the template is safe to commit)
.env*
!.env.example
data/.flask_secret_key

# Delivery archives are generated locally, never source code.
*.zip

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# OS/editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
