# Smart DIT Learning Hub - local configuration template.
# Copy to .env (configure_local.bat does this for you) and fill in what you need.
# Every value is optional for local development; unset values use safe defaults.
# Never commit the real .env file.

# --- Core --------------------------------------------------------------------
# development (default) or production. Production requires the secrets below.
APP_ENV=development
# Generated and stored in data/.flask_secret_key when left empty.
SECRET_KEY=
HOST=127.0.0.1
PORT=5080
# Set to 1 only behind a trusted reverse proxy (e.g. Render).
TRUST_PROXY_HEADERS=0
# Set to 1 when the site is served over HTTPS.
SESSION_COOKIE_SECURE=0

# --- Database ----------------------------------------------------------------
# Empty uses the local SQLite file in data/. Use a Postgres URL in production.
DATABASE_URL=
# Academic year label used when seeding a new installation. Defaults to the
# current August-July year; uncomment to override.
# CURRENT_ACADEMIC_YEAR=2026/2027

# --- Accounts ----------------------------------------------------------------
# Passwords for the seeded demo accounts (min. 12 characters in production).
# Leave commented out locally to keep the README demo passwords.
# INITIAL_STUDENT_PASSWORD=
# INITIAL_LECTURER_PASSWORD=
# Private code (min. 16 characters) required to activate the first HOD account.
HOD_ACTIVATION_CODE=

# --- Gemini AI (optional) ----------------------------------------------------
# A key from https://aistudio.google.com/app/apikey. Empty disables generated answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_OUTPUT_TOKENS=4096
# Keep at 0 until regular chat works and your key is entitled for Search grounding.
GEMINI_ENABLE_WEB_GROUNDING=0

# --- Email notifications (optional) ------------------------------------------
PUBLIC_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_USE_SSL=0
SMTP_TIMEOUT_SECONDS=10
MAIL_FROM=

# --- Supabase private file storage (optional) --------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=resources
